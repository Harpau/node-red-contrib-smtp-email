[
  {
    "id": "flow-imap-forward-smtp",
    "type": "tab",
    "label": "Forward IMAP email via SMTP",
    "disabled": false,
    "info": "Configure both accounts and the new recipient in Node-RED before deploying. The SMTP send node checks its connection when it starts. A connected status records a successful check, not guaranteed email delivery. The check sends no email and never triggers IMAP acknowledgement.\n\nOutput 1 acknowledges and deletes the original email after SMTP reports success. Partial recipient acceptance is intentionally treated as success: if at least one recipient is accepted, rejected recipients in msg.smtpEmail.rejected do not prevent this acknowledgement. Inspect that list before acknowledgement if your flow requires acceptance for every recipient. Output 2 is for failures and must not be wired to the IMAP acknowledgement node. msg.imap.ackToken is preserved unchanged."
  },
  {
    "id": "imap-account-placeholder",
    "type": "imap-email account",
    "name": "imap account placeholder",
    "host": "imap.example.invalid",
    "port": 993,
    "secure": true,
    "rejectUnauthorized": true
  },
  {
    "id": "smtp-account-placeholder",
    "type": "smtp-email account",
    "name": "smtp account placeholder",
    "host": "smtp.example.invalid",
    "port": 587,
    "secure": false,
    "rejectUnauthorized": true,
    "from": "forwarder@example.invalid"
  },
  {
    "id": "imap-email-in",
    "type": "imap-email in",
    "z": "flow-imap-forward-smtp",
    "name": "imap email in",
    "account": "imap-account-placeholder",
    "wires": [
      [
        "smtp-forward-send"
      ]
    ]
  },
  {
    "id": "smtp-forward-send",
    "type": "smtp-email send",
    "z": "flow-imap-forward-smtp",
    "name": "smtp email send",
    "account": "smtp-account-placeholder",
    "toSource": "str",
    "toValue": "recipient@example.invalid",
    "ccSource": "str",
    "ccValue": "",
    "bccSource": "str",
    "bccValue": "",
    "fromSource": "str",
    "fromValue": "",
    "replyToSource": "msg",
    "replyToValue": "email.header.reply-to",
    "subjectSource": "msg",
    "subjectValue": "email.topic",
    "textSource": "msg",
    "textValue": "email.text",
    "htmlSource": "msg",
    "htmlValue": "email.html",
    "attachmentsSource": "msg",
    "attachmentsValue": "email.attachments",
    "wires": [
      [
        "imap-email-ack"
      ],
      [
        "smtp-forward-error"
      ]
    ]
  },
  {
    "id": "imap-email-ack",
    "type": "imap-email ack",
    "z": "flow-imap-forward-smtp",
    "name": "imap email ack",
    "account": "imap-account-placeholder",
    "action": "delete",
    "wires": []
  },
  {
    "id": "smtp-forward-error",
    "type": "debug",
    "z": "flow-imap-forward-smtp",
    "name": "smtp forward failed",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "smtpEmail.error",
    "targetType": "msg",
    "wires": []
  }
]
